MESHCORE_TRANSPORT: "tcp"    # tcp | serial
MESHCORE_HOST: "192.168.86.108"
MESHCORE_PORT: "5000"
RECONNECT_DELAY_S=2
RECONNECT_MAX_DELAY_S=10
WATCHDOG_IDLE_TIMEOUT_S=180 # use 30 for testing
WATCHDOG_CHECK_INTERVAL_S=15 # use 5 for testing
WATCHDOG_PROBE_TIMEOUT_S=5
WATCHDOG_PROBE_RETRIES=2
# MESHCORE_SERIAL_PORT: /dev/ttyACM0 # Required if transport is serial
# MESHCORE_SERIAL_BAUD: 115200
# --- Channels ---
# Comma-separated lists of channels to monitor.
MESHCORE_AI_CHANNELS: "#avl-ai,#ai-test"
MESHCORE_WEATHER_CHANNELS: "#weather-avl"
CHANNEL_SCAN_MAX: "16"
# --- Bot Commands & Settings ---
AI_TRIGGER: "!ai"
PING_TRIGGER: "ping"
HELP_TRIGGER: "!help"
PING_TEMPLATE: "Loud and Clear from AVL\nSNR:{snr}dB\nRSSI:{rssi}dBm\nHops:{hops}" # Format for ping replies
MAX_REPLY_CHARS: "140"       # Max length per transmission chunk
HISTORY_TURNS: "6"           # How many conversation turns to keep in memory
DEDUPE_WINDOW_S: "3.0"       # Time window to ignore duplicate incoming messages
DEBUG: "1"                   # 1=print raw payloads to console
# SYSTEM_PROMPT: "Optional override for default system prompt."
# --- Weather & Alerts ---
WEATHER_LOCATION: "Asheville"
WEATHER_UNITS: "F"           # F for Fahrenheit/mph, C for Celsius/kmh
WEATHER_SCHEDULED_TIMES: "06:00, 13:00, 20:00" # Daily broadcast times (24hr). Blank to disable.
WEATHER_TRIGGER: "!weather"  # On-demand weather command.
WEATHER_ALERTS_NWS_ZONES: "NCZ053,NCC021" # NWS Zone IDs for severe weather.
WEATHER_ALERTS_POLL_INTERVAL_M: "15"      # Alert polling interval in minutes.
# --- LLM Backend Selection ---
LLM_BACKEND: "gemini"        # gemini | ollama | openai_compat
# --- Gemini Settings (only if LLM_BACKEND=gemini) ---
# Requires GEMINI_API_KEY set in host environment or .env file
GEMINI_API_KEY: "KEY HERE"
GEMINI_MODEL: "gemini-3.1-flash-lite-preview"
